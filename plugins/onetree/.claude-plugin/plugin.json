{
  "name": "onetree",
  "version": "0.0.1",
  "description": "Several Claude Code sessions and subagents in one git working tree: each file is claimed before an edit, git commands that erase other agents' work are refused, and work lands through onetree's checks and your tests. Needs the onetree command on PATH.",
  "author": {"name": "Fastnet Oy"},
  "homepage": "https://eliascodefi.github.io/onetree/",
  "repository": "https://github.com/EliasCodeFI/onetree",
  "license": "Apache-2.0",
  "keywords": ["git", "multi-agent", "worktree", "file-locking", "subagents"],
  "hooks": {
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "onetree hook claude session-start", "timeout": 60}]}
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [{"type": "command", "command": "onetree hook claude pre-tool-use", "timeout": 60}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [{"type": "command", "command": "onetree hook claude post-tool-use", "timeout": 60}]
      }
    ],
    "SubagentStop": [
      {"hooks": [{"type": "command", "command": "onetree hook claude subagent-stop", "timeout": 60}]}
    ]
  },
  "mcpServers": {
    "onetree": {"command": "onetree", "args": ["mcp"]}
  }
}
